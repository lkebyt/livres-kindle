# Copier en .env puis remplir.
# Compte Gmail qui envoie les livres + mot de passe d'application (https://myaccount.google.com/apppasswords).
# Cette adresse doit être dans la « liste d'adresses e-mail approuvées » Amazon de chaque lecteur.
SMTP_USER=moi@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Trackers français (definitionName Prowlarr, en minuscules, séparés par des virgules) pour les demandes en français.
FR_TRACKERS=tr4ker,draupnirr

TZ=Europe/Paris
# Dossiers (facultatif) : bibliothèque de livres et téléchargements.
# LIVRES_DIR=/srv/livres
# TELECHARGEMENTS_DIR=/srv/telechargements
